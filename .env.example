SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Scheduling
CRON_SCHEDULE=*/1 8-19 * * 1-5
CRON_TIMEZONE=America/New_York

# Alert thresholds
CPU_THRESHOLD=80
MEMORY_THRESHOLD_MB=450
THROTTLE_DURATION_MS=30000
RECHECK_INTERVAL_MS=5000
RECHECK_MAX_ATTEMPTS=12
SLACK_TIMEOUT_MS=10000
RUN_ONCE=false

# Comma-separated PM2 app names to ignore
PM2_BIN=pm2
EXCLUDED_APPS=pm2-monitor,pm2-logrotate

# Local status endpoint
WEB_ENABLED=true
HOST=127.0.0.1
PORT=3031
STATUS_LOG_FILE=./status-history.json
MAX_HISTORY=1440

# Optional. If set, /status requires either:
# Authorization: Bearer <STATUS_TOKEN>
# or /status?token=<STATUS_TOKEN>
STATUS_TOKEN=
