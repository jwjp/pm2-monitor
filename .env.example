# Copy to .env and fill in. Invalid values stop the monitor at startup with a
# message that names the variable.

# Required unless DRY_RUN=true (or set DISCORD_WEBHOOK_URL)
SLACK_WEBHOOK_URL=
# Optional Discord incoming webhook URL (can be used alongside or instead of Slack)
DISCORD_WEBHOOK_URL=
DISCORD_TIMEOUT_MS=10000

# Log alerts instead of sending them to Slack (same as --dry-run)
DRY_RUN=false

# Scheduling (node-cron syntax; checks outside these hours are skipped, so a
# restart overnight is reported at the first check of the next window)
CRON_SCHEDULE=*/1 8-19 * * 1-5
CRON_TIMEZONE=Asia/Seoul

# Alert thresholds
CPU_THRESHOLD=80
MEMORY_THRESHOLD_MB=450
# Optional per-app overrides. A missing part keeps the global threshold.
# Names cannot contain ":" or ",".
# APP_THRESHOLDS=api:cpu=95:memoryMb=1024,worker:memoryMb=200
# Consecutive checks above a threshold before alerting (filters short spikes)
RESOURCE_ALERT_SAMPLES=2

# Each problem is alerted once when it starts and once when it clears.
# While it lasts, a reminder is sent every ALERT_REPEAT_MS (0 = no reminders).
# THROTTLE_DURATION_MS is accepted as the old name of this setting; values
# under 5 minutes (like the 1.x default 30000) are ignored with a warning.
ALERT_REPEAT_MS=1800000

# Follow-up checks after a restart
RECHECK_INTERVAL_MS=5000
RECHECK_MAX_ATTEMPTS=12
# A restart within this time after "Restart Successful" continues the same
# incident (reported once as a relapse) instead of starting a new one
INCIDENT_STABLE_MS=600000
# Lines of the app's error log attached to restart alerts (0 = off, max 50).
# The lines are sent to Slack; enable only if the logs hold no secrets.
RESTART_LOG_LINES=0

# Requested after every successful check, so a heartbeat service (Healthchecks.io,
# Uptime Kuma push, ...) alerts when the monitor stops. Give that check the
# same schedule as CRON_SCHEDULE. Not used by dry or one-off runs.
HEARTBEAT_URL=
HEARTBEAT_TIMEOUT_MS=10000

SLACK_TIMEOUT_MS=10000

# Run one check and exit (same as --once)
RUN_ONCE=false

# PM2 executable, and comma-separated PM2 app names to ignore
PM2_BIN=pm2
EXCLUDED_APPS=pm2-monitor,pm2-logrotate
# Comma-separated PM2 statuses not to report, e.g. stopped (apps stopped on
# purpose). An app with autorestart: false that crashes is also "stopped".
IGNORE_STATUSES=

# Windows only: PM2 reports CPU/memory as 0 on recent Windows 11 (no wmic).
# When it does, read them from Windows instead.
WINDOWS_USAGE_FALLBACK=true

# Status and metrics endpoint, and web dashboard
WEB_ENABLED=true
HOST=127.0.0.1
PORT=3031
# Relative to the project directory
STATUS_LOG_FILE=./status-history.json
MAX_HISTORY=1440
# Rewrite the history file at most this often (0 = after every check)
STATUS_SAVE_INTERVAL_MS=300000

# Alert and incident state, so a restart of this monitor continues open
# problems. Relative to the project directory. One-off runs do not touch it.
# 0 saves after every check and after each restart watch.
STATE_FILE=./monitor-state.json
STATE_SAVE_INTERVAL_MS=0

# Optional on a loopback HOST, required on any other HOST.
# If set, /status and /metrics require: Authorization: Bearer <STATUS_TOKEN>
STATUS_TOKEN=
