{
  "name": "pm2-monitor",
  "version": "2.1.1",
  "description": "Monitors PM2 processes and sends Slack alerts for restarts, status problems and high resource usage.",
  "main": "pm2-monitor.js",
  "type": "module",
  "scripts": {
    "start": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop pm2-monitor",
    "restart": "pm2 restart pm2-monitor",
    "logs": "pm2 logs pm2-monitor",
    "once": "node pm2-monitor.js --once",
    "dry-run": "node pm2-monitor.js --once --dry-run",
    "test": "node --test",
    "check": "node --check pm2-monitor.js && node --test",
    "audit": "npm audit"
  },
  "author": "",
  "license": "Unlicense",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1"
  }
}
